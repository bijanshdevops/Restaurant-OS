generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  roles     Role[]   @default([CASHIER])
  createdAt DateTime @default(now())

  // --- Phase 4: staff & shift management ---
  // نرخ دستمزد ساعتی ثابت؛ مبنای محاسبه حقوق از روی ساعات ثبت‌شده حضور و غیاب.
  hourlyRate Float @default(0)

  shiftAssignments      ShiftAssignment[]
  staffRequests         StaffRequest[]    @relation("StaffRequestUser")
  reviewedStaffRequests StaffRequest[]    @relation("StaffRequestReviewer")
  targetedStaffRequests StaffRequest[]    @relation("StaffRequestTargetUser")
  payrollPayments       PayrollPayment[]

  // --- Phase 5: multi-branch support ---
  // شعبه‌ی محل خدمت این پرسنل. نقش ADMIN از این محدودیت مستثناست و همه‌ی
  // شعبه‌ها را می‌بیند؛ سایر نقش‌ها همیشه به داده‌های همین شعبه محدودند.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // --- Phase 6: CRM & marketing ---
  customerNotes    CustomerNote[]
  createdCampaigns Campaign[]

  // --- Phase 7: full accounting & tax ---
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
}

enum Role {
  ADMIN
  CASHIER
  CHEF
  ACCOUNTANT
  INVENTORY_MANAGER
}

model MenuItem {
  id          String       @id @default(cuid())
  title       String
  category    String
  subCategory String?
  price       Float
  imageUrl    String?
  isAvailable Boolean      @default(true)
  ingredients String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  // --- Phase 8: kitchen display system (KDS) ---
  // ایستگاه آشپزخانه‌ای که این آیتم باید در آن آماده شود (مثلاً «گریل»،
  // «سرد»، «دسر»)؛ یک برچسب متنی آزاد است، نه یک موجودیت مدیریت‌شده‌ی جدا.
  // آیتم بدون این مقدار روی تابلوی آشپزخانه زیر ایستگاه عمومی («عمومی») قرار
  // می‌گیرد.
  kitchenStation String?
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float
  customerId  String?
  tableId     String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  customer    Customer?   @relation(fields: [customerId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  taxInvoice  TaxInvoice?

  // --- Phase 2: online ordering / delivery ---
  channel         OrderChannel    @default(DINE_IN)
  deliveryAddress String?
  deliveryFee     Float           @default(0)
  pointsRedeemed  Int             @default(0)
  pointsEarned    Int             @default(0)
  deliveryStatus  DeliveryStatus?
  courierId       String?
  courier         Courier?        @relation(fields: [courierId], references: [id])
  payment         Payment?

  // --- Phase 5: multi-branch support ---
  // شعبه‌ای که این سفارش در آن ثبت شده. برای سفارش‌های حضوری/صندوق همیشه
  // مقداردهی می‌شود؛ سفارش‌های آنلاین فعلاً شعبه‌ی مشخصی ندارند (کانال آنلاین
  // هنوز انتخاب شعبه توسط مشتری را پشتیبانی نمی‌کند) و از موجودی شعبه‌ی
  // پیش‌فرض کسر می‌شوند — نک. README برای جزئیات این محدودیت شناخته‌شده.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // --- Phase 6: CRM & marketing ---
  feedback OrderFeedback?

  // --- Phase 7: full accounting & tax ---
  // مبلغ مالیات این سفارش، همان لحظه‌ی ثبت سفارش محاسبه و ذخیره می‌شود تا
  // بعداً (هنگام ثبت تراکنش درآمد در حسابداری) بدون نیاز به محاسبه‌ی مجدد
  // و بدون ریسک ناهم‌خوانی با نرخ مالیات فعلی تنظیمات، در دسترس باشد.
  // سفارش‌های قدیمی‌تر از این migration مقدار ۰ دارند.
  taxAmount Float @default(0)
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  ONLINE_DELIVERY
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  menuItemId  String
  quantity    Int
  priceAtTime Float

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

// از فاز ۵ (چند شعبه‌ای) به بعد، InventoryItem فقط «کاتالوگ» مشترک بین همه‌ی
// شعبه‌هاست (نام، واحد، دسته‌بندی و فرمول غذا/BOM) — موجودی، نقطه‌ی سفارش
// مجدد و قیمت تمام‌شده‌ی واقعی هر ماده، چون بین شعبه‌ها متفاوت است، به
// BranchInventoryStock منتقل شده (هر شعبه رکورد موجودی مستقل خودش را دارد).
model InventoryItem {
  id          String       @id @default(uuid())
  name        String
  category    String
  unit        String
  recipeItems RecipeItem[]

  // --- Phase 3: purchasing / supplier management ---
  purchaseOrderItems PurchaseOrderItem[]

  // --- Phase 5: multi-branch support ---
  branchStocks BranchInventoryStock[]
}

model BranchInventoryStock {
  id              String   @id @default(uuid())
  branchId        String
  inventoryItemId String
  currentStock    Float    @default(0)
  minStockLevel   Float    @default(0)
  costPerUnit     Float    @default(0)
  lastRestocked   DateTime @default(now())

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, inventoryItemId])
  @@index([inventoryItemId])
}

model RecipeItem {
  id              String @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantity        Float

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
}

model Customer {
  id           String        @id @default(uuid())
  fullName     String
  phone        String        @unique
  totalOrders  Int           @default(0)
  totalSpent   Float         @default(0)
  loyaltyTier  LoyaltyTier   @default(NORMAL)
  lastVisit    DateTime      @default(now()) @updatedAt
  orders       Order[]
  reservations Reservation[]

  // --- Phase 2: loyalty points club ---
  pointsBalance       Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]

  // --- Phase 6: CRM & marketing ---
  email          String?
  tags           String[]  @default([])
  marketingOptIn Boolean   @default(true)
  dateOfBirth    DateTime?

  notes              CustomerNote[]
  campaignRecipients CampaignRecipient[]
  feedbacks          OrderFeedback[]

  // برنامه‌ی معرفی: کد اختصاصی هر مشتری برای دعوت دوستان (به‌صورت تنبل و
  // فقط در اولین درخواست ساخته می‌شود، نه لزوماً همان لحظه‌ی ثبت‌نام).
  referralCode String? @unique

  // مشتری‌ای که این مشتری را معرفی کرده (اگر هنگام ثبت‌نام کد معتبری وارد شده باشد).
  referredByCustomerId String?
  referredByCustomer   Customer?  @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id])
  referredCustomers    Customer[] @relation("CustomerReferrals")

  // جلوگیری از اعطای دوبارهٔ پاداش معرفی: فقط یک‌بار، در اولین سفارش این مشتری.
  referralRewardGranted Boolean @default(false)
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Courier {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Payment {
  id           String          @id @default(uuid())
  orderId      String          @unique
  provider     PaymentProvider
  status       PaymentStatus   @default(PENDING)
  amount       Float
  authority    String?
  refId        String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  paidAt       DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

enum PaymentProvider {
  CASH
  ZARINPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  customerId  String
  type        LoyaltyTransactionType
  points      Int
  orderId     String?
  description String
  createdAt   DateTime               @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

model RestaurantSettings {
  id             String @id @default("default")
  taxPercentage  Float  @default(10)
  packagingCost  Float  @default(5000)
  restaurantName String @default("رستوران نمونه سیستم‌عامل")
  contactNumber  String @default("")
  footerMessage  String @default("")

  // سامانه مودیان (از طریق معتمد مالیاتی / TSP)
  modianEnabled   Boolean @default(false)
  economicCode    String  @default("")
  nationalId      String  @default("")
  tspProviderName String  @default("")
  tspApiBaseUrl   String  @default("")
  tspApiKey       String  @default("")

  // --- Phase 2: loyalty points club ---
  // Points earned per 10,000 toman spent, and the toman value of 1 point when redeemed.
  loyaltyPointsPerTenThousand Int   @default(1)
  loyaltyPointValueToman      Float @default(1000)

  // --- Phase 2: delivery ---
  defaultDeliveryFee Float @default(0)

  // --- Phase 6: CRM & marketing ---
  // تعداد امتیاز پاداشی که معرفی‌کننده در اولین سفارش مشتری معرفی‌شده دریافت می‌کند.
  referralBonusPoints Int @default(50)

  updatedAt DateTime @updatedAt
}

model Table {
  id           String        @id @default(uuid())
  number       Int
  capacity     Int           @default(4)
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  orders       Order[]
  reservations Reservation[]

  // --- Phase 5: multi-branch support ---
  // شماره‌ی میز فقط در محدوده‌ی هر شعبه یکتاست، نه در کل سیستم (هر شعبه
  // می‌تواند میز شماره ۱ خودش را داشته باشد).
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, number])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model Reservation {
  id              String            @id @default(uuid())
  tableId         String
  customerId      String?
  guestName       String
  guestPhone      String
  partySize       Int
  reservationTime DateTime
  status          ReservationStatus @default(PENDING)
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  table    Table     @relation(fields: [tableId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  // --- Phase 5: multi-branch support --- (denormalized from table.branchId at creation, for direct filtering)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TaxInvoice {
  id              String           @id @default(uuid())
  orderId         String           @unique
  status          TaxInvoiceStatus @default(PENDING)
  payload         Json
  uid             String?
  referenceNumber String?
  taxUid          String?
  errorMessage    String?
  sentAt          DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

enum TaxInvoiceStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

enum LoyaltyTier {
  NORMAL
  BRONZE
  SILVER
  GOLD
  VIP
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  description String
  amount      Float
  createdAt   DateTime        @default(now())

  // --- Phase 5: multi-branch support ---
  // مثل Order.branchId: تراکنش‌های وابسته به یک شعبه (فروش صندوق، خرید،
  // حقوق) مقداردهی می‌شوند؛ تراکنش سفارش‌های آنلاین فعلاً بدون شعبه‌اند.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // --- Phase 7: full accounting & tax ---
  // مبلغ مالیات این تراکنش (برای درآمد: مالیات فروش/خروجی؛ برای هزینه:
  // مالیات خریدِ برآوردی/ورودی) — جدا از amount نگه‌داشته می‌شود تا گزارش
  // مالیات (خروجی منهای ورودی) قابل محاسبه باشد، بدون آنکه به معماری کامل
  // دفترداری دوطرفه (debit/credit ledger) نیاز باشد.
  taxAmount Float @default(0)

  // دسته‌بندی حساب (Chart of Accounts سبک‌وزن). تراکنش‌های خودکار (سفارش،
  // خرید کالا، حقوق) با دسته‌ی سیستمی مربوطه برچسب می‌خورند؛ تراکنش‌های
  // دستی پیش‌فرض روی «سایر درآمدها/هزینه‌ها» می‌روند مگر کاربر دسته‌ی
  // دیگری انتخاب کند.
  categoryId String?
  category   TransactionCategory? @relation(fields: [categoryId], references: [id])

  // ردیابی منبع: این تراکنش از کدام رویداد واقعی کسب‌وکار ساخته شده
  // (مثلاً 'ORDER' + شناسه‌ی سفارش). تراکنش‌های دستی این دو فیلد را خالی
  // دارند و همین، معیار مجاز بودن حذف (deleteTransaction) است — یک تراکنش
  // که پشتوانه‌ی رویداد واقعی دارد هرگز حذف نمی‌شود، فقط قابل بازطبقه‌بندی
  // (recategorize) است.
  referenceType String?
  referenceId   String?

  createdByUserId String?
  createdBy       User?   @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id])

  @@index([categoryId])
  @@index([referenceType, referenceId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// --- Phase 7: full accounting & tax ---
enum TransactionCategoryType {
  INCOME
  EXPENSE
}

model TransactionCategory {
  id   String                  @id @default(uuid())
  name String
  type TransactionCategoryType

  // دسته‌های سیستمی (فروش POS، فروش آنلاین، خرید کالا، حقوق و دستمزد، سایر
  // درآمدها/هزینه‌ها) با شناسه‌ی ثابت در migration ساخته می‌شوند و توسط
  // اکشن‌های خودکار حسابداری استفاده می‌شوند؛ حذف‌شدنی نیستند (فقط
  // دسته‌های ساخته‌شده توسط کاربر قابل حذف‌اند، آن‌هم وقتی هیچ تراکنشی به
  // آن‌ها متصل نباشد).
  isSystem Boolean @default(false)

  // نرخ پیش‌فرض مالیات این دسته (درصد) — برای محاسبه‌ی خودکار taxAmount
  // وقتی کاربر مقدار مالیات را صریحاً وارد نکند. null یعنی این دسته
  // به‌طور پیش‌فرض مشمول مالیات نیست.
  taxRatePercent Float?

  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([name, type])
}

model Printer {
  id             String                @id @default(uuid())
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(NETWORK)

  ipAddress String?
  port      Int?    @default(9100)

  path String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum PrinterType {
  CASHIER
  KITCHEN
}

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
}

// =====================================================================
// Phase 3: Purchasing & Supplier Management
// =====================================================================

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String   @default("")
  phone       String   @default("")
  address     String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // مانده بدهی ما به این تأمین‌کننده: با دریافت واقعی کالا افزایش،
  // و با ثبت پرداخت کاهش می‌یابد. هرگز مستقیماً از کلاینت تنظیم نمی‌شود.
  balanceOwed Float @default(0)

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  // --- Phase 5: multi-branch support ---
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Float               @default(0)
  notes       String              @default("")
  createdAt   DateTime            @default(now())
  orderedAt   DateTime?
  receivedAt  DateTime?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  payments SupplierPayment[]

  // --- Phase 5: multi-branch support --- (denormalized from supplier.branchId at creation)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantityOrdered  Float
  quantityReceived Float  @default(0)
  unitCost         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  amount          Float
  method          String   @default("")
  note            String   @default("")
  createdAt       DateTime @default(now())

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([supplierId])
}

// =====================================================================
// Phase 4: Staff & Shift Management
// =====================================================================

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Shift {
  id        String      @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  role      String      @default("")
  notes     String      @default("")
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now())

  assignments ShiftAssignment[]

  // --- Phase 5: multi-branch support ---
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([branchId])
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  shiftId   String
  userId    String
  createdAt DateTime @default(now())

  shift      Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  attendance Attendance?

  swapRequestsAsSource StaffRequest[] @relation("SwapSourceAssignment")

  @@unique([shiftId, userId])
  @@index([userId])
}

model Attendance {
  id                String    @id @default(uuid())
  shiftAssignmentId String    @unique
  clockIn           DateTime?
  clockOut          DateTime?
  createdAt         DateTime  @default(now())

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)

  // وقتی این حضور در یک اجرای حقوق‌دهی لحاظ شود، برای جلوگیری از پرداخت دوباره ثبت می‌شود.
  payrollPaymentId String?
  payrollPayment   PayrollPayment? @relation(fields: [payrollPaymentId], references: [id])

  @@index([payrollPaymentId])
}

enum StaffRequestType {
  LEAVE
  SHIFT_SWAP
}

enum StaffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffRequest {
  id           String             @id @default(uuid())
  type         StaffRequestType
  userId       String
  status       StaffRequestStatus @default(PENDING)
  reason       String             @default("")
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  // برای درخواست مرخصی (LEAVE)
  startDate DateTime?
  endDate   DateTime?

  // برای درخواست جابجایی شیفت (SHIFT_SWAP): شیفت مبدأ متعلق به userId
  // و همکاری که قرار است آن را عهده‌دار شود.
  sourceAssignmentId String?
  targetUserId       String?

  user             User             @relation("StaffRequestUser", fields: [userId], references: [id])
  reviewedBy       User?            @relation("StaffRequestReviewer", fields: [reviewedById], references: [id])
  sourceAssignment ShiftAssignment? @relation("SwapSourceAssignment", fields: [sourceAssignmentId], references: [id])
  targetUser       User?            @relation("StaffRequestTargetUser", fields: [targetUserId], references: [id])

  @@index([userId])
  @@index([status])
}

model PayrollPayment {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  totalHours  Float
  hourlyRate  Float
  totalAmount Float
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  attendances Attendance[]

  @@index([userId])
}

// =====================================================================
// Phase 5: Multi-Branch Support
// =====================================================================

// شعبه‌ی فیزیکی رستوران. دقیقاً یک شعبه باید isDefault=true داشته باشد —
// همان شعبه‌ای که سفارش‌های آنلاین (که فعلاً انتخاب شعبه ندارند) و شعبه‌ی
// اولیه‌ی سیستم (پیش از وجود این ماژول) به آن نگاشت می‌شوند.
model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  users           User[]
  tables          Table[]
  reservations    Reservation[]
  orders          Order[]
  transactions    Transaction[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  shifts          Shift[]
  inventoryStocks BranchInventoryStock[]
}


// =====================================================================
// Phase 6: CRM & Marketing
// =====================================================================

enum CampaignSegmentType {
  ALL // همه‌ی مشتریانی که اجازه‌ی دریافت پیامک بازاریابی داده‌اند
  TIER // یک سطح مشخص از باشگاه وفاداری (segmentParams.tier)
  TAG // مشتریان دارای یک برچسب مشخص (segmentParams.tag)
  INACTIVE // مشتریانی که از N روز پیش بازدید/سفارشی نداشته‌اند (segmentParams.daysSinceLastVisit)
  CUSTOM // فهرست دستی از شناسه‌ی مشتریان (segmentParams.customerIds)
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPT_OUT
}

// یادداشت داخلی پرسنل روی پروفایل یک مشتری (تاریخچه‌ی تعامل/سلیقه/شکایت و...).
model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([customerId])
}

// یک کمپین پیامکی بازاریابی: پیام + بخش هدف (segment)؛ فقط ADMIN می‌سازد و ارسال می‌کند.
model Campaign {
  id             String              @id @default(uuid())
  name           String
  message        String
  segmentType    CampaignSegmentType
  segmentParams  Json?
  status         CampaignStatus      @default(DRAFT)
  recipientCount Int                 @default(0)
  sentCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  createdById    String
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  createdBy  User                @relation(fields: [createdById], references: [id])
  recipients CampaignRecipient[]
}

// وضعیت ارسال یک کمپین به هر مشتری، برای گزارش‌گیری و جلوگیری از ارسال تکراری.
model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  customerId String
  status     CampaignRecipientStatus @default(PENDING)
  sentAt     DateTime?
  error      String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId])
  @@index([customerId])
}

// بازخورد/امتیاز مشتری روی یک سفارش تکمیل‌شده (از طریق پورتال آنلاین مشتری).
model OrderFeedback {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}
