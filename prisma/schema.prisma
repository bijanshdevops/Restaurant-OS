generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  roles     Role[]   @default([CASHIER])
  createdAt DateTime @default(now())

  // --- Phase 4: staff & shift management ---
  // نرخ دستمزد ساعتی ثابت؛ مبنای محاسبه حقوق از روی ساعات ثبت‌شده حضور و غیاب.
  hourlyRate Float @default(0)

  shiftAssignments      ShiftAssignment[]
  staffRequests         StaffRequest[]    @relation("StaffRequestUser")
  reviewedStaffRequests StaffRequest[]    @relation("StaffRequestReviewer")
  targetedStaffRequests StaffRequest[]    @relation("StaffRequestTargetUser")
  payrollPayments       PayrollPayment[]

  // --- Phase 5: multi-branch support ---
  // شعبه‌ی محل خدمت این پرسنل. نقش ADMIN از این محدودیت مستثناست و همه‌ی
  // شعبه‌ها را می‌بیند؛ سایر نقش‌ها همیشه به داده‌های همین شعبه محدودند.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // --- Phase 6: CRM & marketing ---
  customerNotes    CustomerNote[]
  createdCampaigns Campaign[]

  // --- Phase 7: full accounting & tax ---
  createdTransactions Transaction[] @relation("TransactionCreatedBy")

  // --- Phase 10: refunds & returns ---
  createdRefunds Refund[] @relation("RefundCreatedBy")

  // --- Phase 11: audit log ---
  auditLogs AuditLog[]

  // --- Phase 18: cash flow & bank/cash reconciliation ---
  createdAccountTransfers      AccountTransfer[]      @relation("AccountTransferCreatedBy")
  createdAccountReconciliations AccountReconciliation[] @relation("AccountReconciliationCreatedBy")
}

enum Role {
  ADMIN
  CASHIER
  CHEF
  ACCOUNTANT
  INVENTORY_MANAGER
}

model MenuItem {
  id          String       @id @default(cuid())
  title       String
  category    String
  subCategory String?
  price       Float
  imageUrl    String?
  isAvailable Boolean      @default(true)
  ingredients String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]

  // --- Phase 13: modifiers/add-ons, yield %, sub-recipes ---
  modifierGroupLinks MenuItemModifierGroup[]

  // --- Phase 8: kitchen display system (KDS) ---
  // ایستگاه آشپزخانه‌ای که این آیتم باید در آن آماده شود (مثلاً «گریل»،
  // «سرد»، «دسر»)؛ یک برچسب متنی آزاد است، نه یک موجودیت مدیریت‌شده‌ی جدا.
  // آیتم بدون این مقدار روی تابلوی آشپزخانه زیر ایستگاه عمومی («عمومی») قرار
  // می‌گیرد.
  kitchenStation String?

  // --- Phase 15: combo meals ---
  // true یعنی این آیتمِ منو در واقع یک «آیتمِ سایه» است که خودکار برای
  // نمایندگیِ یک Combo ساخته شده (نک. توضیحِ Combo پایینِ فایل) — نه یک
  // آیتمِ منویِ واقعی که ادمین مستقیماً فرمول/موجودی برایش تعریف کند.
  // فرمولِ مصرفِ موادِ اولیه‌ی آن از ترکیبِ اجزای Combo (ComboItem) محاسبه
  // می‌شود، نه از RecipeItem خودش (که برای این آیتم هرگز پر نمی‌شود).
  isCombo Boolean @default(false)
  // رابطه‌ی معکوسِ Combo.menuItemId (یک‌به‌یک).
  combo   Combo?

  // --- Phase 15: happy hour ---
  happyHourRuleLinks  HappyHourRuleItem[]
  comboComponentLinks ComboItem[]
  comboComponentSnapshots OrderItemComboComponent[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float
  customerId  String?
  tableId     String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  customer    Customer?   @relation(fields: [customerId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  taxInvoice  TaxInvoice?

  // --- Phase 2: online ordering / delivery ---
  channel         OrderChannel    @default(DINE_IN)
  deliveryAddress String?
  deliveryFee     Float           @default(0)
  pointsRedeemed  Int             @default(0)
  pointsEarned    Int             @default(0)
  deliveryStatus  DeliveryStatus?
  courierId       String?
  courier         Courier?        @relation(fields: [courierId], references: [id])
  payment         Payment?

  // --- Phase 17: third-party delivery/courier provider integration ---
  // وقتی خالی است یعنی این سفارش (اگر اصلاً ارسالی باشد) با گردش‌کار داخلیِ
  // پیک دستی (نک. courierId بالا) مدیریت می‌شود — بدون تغییر نسبت به قبل.
  // وقتی مقداردهی شده یعنی سفارش خودکار به شخص‌ثالث ارسال شده و وضعیتش
  // (deliveryStatus بالا) دیگر از طریق وب‌هوکِ آن سرویس به‌روزرسانی می‌شود، نه
  // با دکمه‌های دستیِ تخته‌ی تحویل.
  deliveryProvider    DeliveryProvider?
  externalDeliveryId  String?           @unique
  externalTrackingUrl String?

  // --- Phase 5: multi-branch support ---
  // شعبه‌ای که این سفارش در آن ثبت شده. برای سفارش‌های حضوری/صندوق همیشه
  // مقداردهی می‌شود؛ سفارش‌های آنلاین فعلاً شعبه‌ی مشخصی ندارند (کانال آنلاین
  // هنوز انتخاب شعبه توسط مشتری را پشتیبانی نمی‌کند) و از موجودی شعبه‌ی
  // پیش‌فرض کسر می‌شوند — نک. README برای جزئیات این محدودیت شناخته‌شده.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // --- Phase 6: CRM & marketing ---
  feedback OrderFeedback?

  // --- Phase 7: full accounting & tax ---
  // مبلغ مالیات این سفارش، همان لحظه‌ی ثبت سفارش محاسبه و ذخیره می‌شود تا
  // بعداً (هنگام ثبت تراکنش درآمد در حسابداری) بدون نیاز به محاسبه‌ی مجدد
  // و بدون ریسک ناهم‌خوانی با نرخ مالیات فعلی تنظیمات، در دسترس باشد.
  // سفارش‌های قدیمی‌تر از این migration مقدار ۰ دارند.
  taxAmount Float @default(0)

  // --- Phase 10: refunds & returns ---
  refunds Refund[]

  // --- Phase 14: gift cards & discount coupons ---
  // اسنپ‌شاتِ کدِ تخفیفِ اعمال‌شده (اگر بود) + مبلغِ کسرشده، مستقل از
  // این‌که بعداً خودِ Coupon تغییر کند یا حذف شود.
  couponId       String?
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  couponCode     String?
  discountAmount Float   @default(0)

  giftCardId         String?
  giftCard           GiftCard? @relation(fields: [giftCardId], references: [id])
  giftCardAmountUsed Float     @default(0)

  giftCardTransactions GiftCardTransaction[]
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderChannel {
  DINE_IN
  TAKEAWAY
  ONLINE_DELIVERY
  QR_DINE_IN
}

// فاز ۱۷: کدام سرویسِ شخص‌ثالثِ پیک این سفارش را در دست دارد. فعلاً فقط یک
// Provider شبیه‌سازی‌شده وجود دارد (هیچ حساب/مستندات API واقعی‌ای برای اسنپ‌فود،
// میار یا مشابه در دسترس نیست) — افزودن یک سرویسِ واقعیِ بعدی فقط یک مقدارِ
// جدید اینجا و یک پیاده‌سازیِ تازه از DeliveryProviderAdapter در
// src/lib/deliveryProviders.ts نیاز دارد، بدون تغییر در بقیه‌ی برنامه.
enum DeliveryProvider {
  MOCK_EXPRESS
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  FAILED
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  menuItemId  String
  quantity    Int
  priceAtTime Float

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  // --- Phase 13: modifiers/add-ons + دقیقاً همان مقدار موجودیِ کسرشده در
  // لحظه‌ی ثبت سفارش (بعد از اعمال درصد بازده، بسط زیرفرمول‌ها و
  // مدیفایرهای انتخابی) — تا مرجوعی (refund.ts) همیشه دقیقاً همان مقدار را
  // برگرداند، حتی اگر فرمول/مدیفایر/درصد بازده بعداً تغییر کند.
  modifiers        OrderItemModifier[]
  ingredientUsages OrderItemIngredientUsage[]

  // --- Phase 10: refunds & returns ---
  // مجموع تعدادی که تاکنون از همین ردیف سفارش مرجوع شده؛ هرگز نمی‌تواند از
  // quantity بیشتر شود. یک آیتم وقتی «کاملاً مرجوع‌شده» است که این مقدار با
  // quantity برابر باشد.
  refundedQuantity Int          @default(0)
  refundItems      RefundItem[]

  // --- Phase 15: happy hour ---
  // عکسِ لحظه‌ایِ قانونِ Happy Hour (اگر در لحظه‌ی ثبتِ سفارش روی این آیتم
  // فعال بوده): priceAtTime از قبل شاملِ این تخفیف است (روی قیمتِ پایه،
  // پیش از افزودنِ مدیفایرها)؛ این فیلدها فقط برای شفافیت/گزارش نگه داشته
  // می‌شوند و در محاسبه‌ی totalAmount دوباره دخیل نیستند. نامِ قانون هم
  // جداگانه ذخیره می‌شود (مثلِ الگویِ OrderItemModifier.modifierName) تا
  // اگر قانون بعداً ویرایش/حذف شود، تاریخچه دست‌نخورده بماند.
  happyHourRuleId          String?
  happyHourRule            HappyHourRule? @relation(fields: [happyHourRuleId], references: [id], onDelete: SetNull)
  happyHourRuleName        String?
  happyHourDiscountPerUnit Float          @default(0)

  // --- Phase 15: combo meals ---
  // عکسِ لحظه‌ایِ اجزای Combo در لحظه‌ی سفارش (فقط وقتی menuItemId به یک
  // آیتمِ combo اشاره کند) — صرفاً برای شفافیت/گزارشِ آینده؛ محاسبه‌ی
  // مصرفِ مواد اولیه از OrderItemIngredientUsage (که هنگامِ ثبتِ سفارش با
  // بسطِ همین اجزا محاسبه شده) انجام می‌شود، نه از این جدول.
  comboComponents OrderItemComboComponent[]
}

// از فاز ۵ (چند شعبه‌ای) به بعد، InventoryItem فقط «کاتالوگ» مشترک بین همه‌ی
// شعبه‌هاست (نام، واحد، دسته‌بندی و فرمول غذا/BOM) — موجودی، نقطه‌ی سفارش
// مجدد و قیمت تمام‌شده‌ی واقعی هر ماده، چون بین شعبه‌ها متفاوت است، به
// BranchInventoryStock منتقل شده (هر شعبه رکورد موجودی مستقل خودش را دارد).
model InventoryItem {
  id          String       @id @default(uuid())
  name        String
  category    String
  unit        String
  recipeItems RecipeItem[]

  // --- Phase 3: purchasing / supplier management ---
  purchaseOrderItems PurchaseOrderItem[]

  // --- Phase 5: multi-branch support ---
  branchStocks BranchInventoryStock[]

  // --- Phase 13: modifiers/add-ons, yield %, sub-recipes ---
  modifierRecipeItems       ModifierRecipeItem[]
  subRecipeItems            SubRecipeItem[]
  orderItemIngredientUsages OrderItemIngredientUsage[]
}

model BranchInventoryStock {
  id              String   @id @default(uuid())
  branchId        String
  inventoryItemId String
  currentStock    Float    @default(0)
  minStockLevel   Float    @default(0)
  costPerUnit     Float    @default(0)
  lastRestocked   DateTime @default(now())

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, inventoryItemId])
  @@index([inventoryItemId])
}

// از فاز ۱۳ به بعد، هر ردیفِ فرمول یا مستقیماً به یک ماده‌ی اولیه‌ی خام
// اشاره می‌کند (inventoryItemId) یا به یک زیرفرمول (subRecipeId) — دقیقاً
// یکی از این دو، هرگز هر دو یا هیچ‌کدام (این محدودیت در سطح اکشن سرور
// اعمال می‌شود، چون Prisma/Postgres محدودیت XOR ستونی بومی ندارد).
// yieldPercent («درصد بازده» / معکوسِ درصد ضایعات) یعنی از هر واحدِ خامِ
// خریداری‌شده، چند درصد واقعاً قابل استفاده در این فرمول است — مقدار
// پیش‌فرض ۱۰۰ یعنی «بدون ضایعات»، دقیقاً همان رفتار قبل از این فاز.
model RecipeItem {
  id              String  @id @default(uuid())
  menuItemId      String
  inventoryItemId String?
  subRecipeId     String?
  quantity        Float
  yieldPercent    Float   @default(100)

  menuItem      MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  subRecipe     SubRecipe?     @relation(fields: [subRecipeId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, inventoryItemId])
  @@unique([menuItemId, subRecipeId])
}

model Customer {
  id           String        @id @default(uuid())
  fullName     String
  phone        String        @unique
  totalOrders  Int           @default(0)
  totalSpent   Float         @default(0)
  loyaltyTier  LoyaltyTier   @default(NORMAL)
  lastVisit    DateTime      @default(now()) @updatedAt
  orders       Order[]
  reservations Reservation[]

  // --- Phase 2: loyalty points club ---
  pointsBalance       Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]

  // --- Phase 6: CRM & marketing ---
  email          String?
  tags           String[]  @default([])
  marketingOptIn Boolean   @default(true)
  dateOfBirth    DateTime?

  notes              CustomerNote[]
  campaignRecipients CampaignRecipient[]
  feedbacks          OrderFeedback[]

  // برنامه‌ی معرفی: کد اختصاصی هر مشتری برای دعوت دوستان (به‌صورت تنبل و
  // فقط در اولین درخواست ساخته می‌شود، نه لزوماً همان لحظه‌ی ثبت‌نام).
  referralCode String? @unique

  // مشتری‌ای که این مشتری را معرفی کرده (اگر هنگام ثبت‌نام کد معتبری وارد شده باشد).
  referredByCustomerId String?
  referredByCustomer   Customer?  @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id])
  referredCustomers    Customer[] @relation("CustomerReferrals")

  // جلوگیری از اعطای دوبارهٔ پاداش معرفی: فقط یک‌بار، در اولین سفارش این مشتری.
  referralRewardGranted Boolean @default(false)

  // --- Phase 14: gift cards ---
  giftCards GiftCard[]
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Courier {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Payment {
  id           String          @id @default(uuid())
  orderId      String          @unique
  provider     PaymentProvider
  status       PaymentStatus   @default(PENDING)
  amount       Float
  authority    String?
  refId        String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  paidAt       DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

enum PaymentProvider {
  CASH
  ZARINPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  customerId  String
  type        LoyaltyTransactionType
  points      Int
  orderId     String?
  description String
  createdAt   DateTime               @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

model RestaurantSettings {
  id             String @id @default("default")
  taxPercentage  Float  @default(10)
  packagingCost  Float  @default(5000)
  restaurantName String @default("رستوران نمونه سیستم‌عامل")
  contactNumber  String @default("")
  footerMessage  String @default("")

  // سامانه مودیان (از طریق معتمد مالیاتی / TSP)
  modianEnabled   Boolean @default(false)
  economicCode    String  @default("")
  nationalId      String  @default("")
  tspProviderName String  @default("")
  tspApiBaseUrl   String  @default("")
  tspApiKey       String  @default("")

  // --- Phase 2: loyalty points club ---
  // Points earned per 10,000 toman spent, and the toman value of 1 point when redeemed.
  loyaltyPointsPerTenThousand Int   @default(1)
  loyaltyPointValueToman      Float @default(1000)

  // --- Phase 2: delivery ---
  defaultDeliveryFee Float @default(0)

  // --- Phase 6: CRM & marketing ---
  // تعداد امتیاز پاداشی که معرفی‌کننده در اولین سفارش مشتری معرفی‌شده دریافت می‌کند.
  referralBonusPoints Int @default(50)

  updatedAt DateTime @updatedAt
}

model Table {
  id           String        @id @default(uuid())
  number       Int
  capacity     Int           @default(4)
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  orders       Order[]
  reservations Reservation[]

  // --- Phase 12: waitlist & reservation deposits ---
  waitlistEntries WaitlistEntry[]

  // --- Phase 5: multi-branch support ---
  // شماره‌ی میز فقط در محدوده‌ی هر شعبه یکتاست، نه در کل سیستم (هر شعبه
  // می‌تواند میز شماره ۱ خودش را داشته باشد).
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, number])
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model Reservation {
  id              String            @id @default(uuid())
  tableId         String
  customerId      String?
  guestName       String
  guestPhone      String
  partySize       Int
  reservationTime DateTime
  status          ReservationStatus @default(PENDING)
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  table    Table     @relation(fields: [tableId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  // --- Phase 5: multi-branch support --- (denormalized from table.branchId at creation, for direct filtering)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // --- Phase 12: reservation deposits ---
  // مبلغ پیش‌پرداختِ دریافت‌شده هنگام ثبت رزرو (۰ یعنی بدون پیش‌پرداخت).
  // سیاست استرداد این فاز «استرداد کامل، در هر زمان» است — یعنی هیچ جریمه‌ی
  // زمان‌بندی‌شده‌ای برای لغو/عدم‌حضور اعمال نمی‌شود؛ استرداد یک اقدام صریح
  // پرسنل است (refundReservationDeposit)، نه خودکار روی تغییر وضعیت رزرو.
  depositAmount     Float     @default(0)
  depositRefundedAt DateTime?
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TaxInvoice {
  id              String           @id @default(uuid())
  orderId         String           @unique
  status          TaxInvoiceStatus @default(PENDING)
  payload         Json
  uid             String?
  referenceNumber String?
  taxUid          String?
  errorMessage    String?
  sentAt          DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

enum TaxInvoiceStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

enum LoyaltyTier {
  NORMAL
  BRONZE
  SILVER
  GOLD
  VIP
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  description String
  amount      Float
  createdAt   DateTime        @default(now())

  // --- Phase 5: multi-branch support ---
  // مثل Order.branchId: تراکنش‌های وابسته به یک شعبه (فروش صندوق، خرید،
  // حقوق) مقداردهی می‌شوند؛ تراکنش سفارش‌های آنلاین فعلاً بدون شعبه‌اند.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // --- Phase 7: full accounting & tax ---
  // مبلغ مالیات این تراکنش (برای درآمد: مالیات فروش/خروجی؛ برای هزینه:
  // مالیات خریدِ برآوردی/ورودی) — جدا از amount نگه‌داشته می‌شود تا گزارش
  // مالیات (خروجی منهای ورودی) قابل محاسبه باشد، بدون آنکه به معماری کامل
  // دفترداری دوطرفه (debit/credit ledger) نیاز باشد.
  taxAmount Float @default(0)

  // دسته‌بندی حساب (Chart of Accounts سبک‌وزن). تراکنش‌های خودکار (سفارش،
  // خرید کالا، حقوق) با دسته‌ی سیستمی مربوطه برچسب می‌خورند؛ تراکنش‌های
  // دستی پیش‌فرض روی «سایر درآمدها/هزینه‌ها» می‌روند مگر کاربر دسته‌ی
  // دیگری انتخاب کند.
  categoryId String?
  category   TransactionCategory? @relation(fields: [categoryId], references: [id])

  // ردیابی منبع: این تراکنش از کدام رویداد واقعی کسب‌وکار ساخته شده
  // (مثلاً 'ORDER' + شناسه‌ی سفارش). تراکنش‌های دستی این دو فیلد را خالی
  // دارند و همین، معیار مجاز بودن حذف (deleteTransaction) است — یک تراکنش
  // که پشتوانه‌ی رویداد واقعی دارد هرگز حذف نمی‌شود، فقط قابل بازطبقه‌بندی
  // (recategorize) است.
  referenceType String?
  referenceId   String?

  createdByUserId String?
  createdBy       User?   @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id])

  // --- Phase 18: cash flow & bank/cash reconciliation ---
  // این تراکنش به کدام حساب (صندوق نقد/بانک/درگاه پرداخت) تعلق دارد. فروش
  // نقد/کارتیِ صندوق (POS) و سفارش‌های آنلاین/QR (که همیشه از درگاه
  // زرین‌پال می‌گذرند) خودکار مقداردهی می‌شوند؛ تراکنش‌های خودکار دیگر
  // (خرید از تأمین‌کننده، حقوق) و تراکنش‌های دستیِ قدیمی‌تر از این فاز فعلاً
  // بدون حساب (accountId=null) می‌مانند و بعداً از طریق همان اکشنِ
  // بازطبقه‌بندیِ دسته (updateTransactionCategory) قابل تخصیص‌اند.
  accountId String?
  account   FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([categoryId])
  @@index([referenceType, referenceId])
  @@index([accountId])
}

// فاز ۱۸: جریان نقدی و مغایرت‌گیری صندوق/بانک.
//
// یک «حساب مالی» نمایانگر یک صندوق نقد، حساب بانکی، یا درگاه پرداخت
// آنلاین است که تراکنش‌های درآمد/هزینه (Transaction.accountId) و
// انتقال‌های بین‌حسابی (AccountTransfer) به آن مرتبط می‌شوند. سه حساب
// سیستمی (نقد/بانک/درگاه) در migration این فاز از پیش ساخته شده‌اند؛
// حساب‌های دلخواه بیشتر را ADMIN/ACCOUNTANT می‌توانند اضافه کنند. موجودیِ
// هر حساب ذخیره نمی‌شود — همیشه زنده از روی مجموع تراکنش‌ها و انتقال‌های
// مرتبط محاسبه می‌شود (نک. getAccountBalances در accounting.ts).
model FinancialAccount {
  id        String              @id @default(uuid())
  name      String              @unique
  type      FinancialAccountType
  isSystem  Boolean             @default(false)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())

  transactions    Transaction[]
  transfersOut    AccountTransfer[]        @relation("TransferFrom")
  transfersIn     AccountTransfer[]        @relation("TransferTo")
  reconciliations AccountReconciliation[]
}

enum FinancialAccountType {
  CASH
  BANK
  GATEWAY
  OTHER
}

// انتقال دستیِ موجودی بین دو حساب مالی (مثلاً واریز نقدیِ صندوق به بانک) —
// عمداً از جدول Transaction (INCOME/EXPENSE) جدا نگه داشته شده تا هرگز روی
// صورت سود و زیان یا گزارش مالیات (فاز ۷) اثر نگذارد؛ فقط موجودیِ محاسبه‌شده‌ی
// دو حساب را جابه‌جا می‌کند.
model AccountTransfer {
  id        String   @id @default(uuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  fromAccountId String
  fromAccount   FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id])

  createdByUserId String?
  createdBy       User?   @relation("AccountTransferCreatedBy", fields: [createdByUserId], references: [id])
}

// ثبتِ یک جلسه‌ی مغایرت‌گیری: کارمند موجودیِ واقعیِ شمرده‌شده‌ی یک حساب را
// وارد می‌کند و سیستم آن را با موجودیِ محاسبه‌شده از دفتر مقایسه می‌کند.
// طبق تصمیمِ محدوده‌ی این فاز، این ثبت فقط برای مستندسازی/بررسیِ بعدی است؛
// هیچ تراکنشِ اصلاحیِ خودکاری برای صفر کردنِ مغایرت ساخته نمی‌شود.
model AccountReconciliation {
  id              String   @id @default(uuid())
  computedBalance Float
  countedBalance  Float
  difference      Float
  note            String?
  createdAt       DateTime @default(now())

  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])

  createdByUserId String?
  createdBy       User?   @relation("AccountReconciliationCreatedBy", fields: [createdByUserId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// --- Phase 7: full accounting & tax ---
enum TransactionCategoryType {
  INCOME
  EXPENSE
}

model TransactionCategory {
  id   String                  @id @default(uuid())
  name String
  type TransactionCategoryType

  // دسته‌های سیستمی (فروش POS، فروش آنلاین، خرید کالا، حقوق و دستمزد، سایر
  // درآمدها/هزینه‌ها) با شناسه‌ی ثابت در migration ساخته می‌شوند و توسط
  // اکشن‌های خودکار حسابداری استفاده می‌شوند؛ حذف‌شدنی نیستند (فقط
  // دسته‌های ساخته‌شده توسط کاربر قابل حذف‌اند، آن‌هم وقتی هیچ تراکنشی به
  // آن‌ها متصل نباشد).
  isSystem Boolean @default(false)

  // نرخ پیش‌فرض مالیات این دسته (درصد) — برای محاسبه‌ی خودکار taxAmount
  // وقتی کاربر مقدار مالیات را صریحاً وارد نکند. null یعنی این دسته
  // به‌طور پیش‌فرض مشمول مالیات نیست.
  taxRatePercent Float?

  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@unique([name, type])
}

model Printer {
  id             String                @id @default(uuid())
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(NETWORK)

  ipAddress String?
  port      Int?    @default(9100)

  path String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum PrinterType {
  CASHIER
  KITCHEN
}

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
}

// =====================================================================
// Phase 3: Purchasing & Supplier Management
// =====================================================================

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String   @default("")
  phone       String   @default("")
  address     String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // مانده بدهی ما به این تأمین‌کننده: با دریافت واقعی کالا افزایش،
  // و با ثبت پرداخت کاهش می‌یابد. هرگز مستقیماً از کلاینت تنظیم نمی‌شود.
  balanceOwed Float @default(0)

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  // --- Phase 5: multi-branch support ---
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Float               @default(0)
  notes       String              @default("")
  createdAt   DateTime            @default(now())
  orderedAt   DateTime?
  receivedAt  DateTime?

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  payments SupplierPayment[]

  // --- Phase 5: multi-branch support --- (denormalized from supplier.branchId at creation)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantityOrdered  Float
  quantityReceived Float  @default(0)
  unitCost         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  amount          Float
  method          String   @default("")
  note            String   @default("")
  createdAt       DateTime @default(now())

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([supplierId])
}

// =====================================================================
// Phase 4: Staff & Shift Management
// =====================================================================

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Shift {
  id        String      @id @default(uuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  role      String      @default("")
  notes     String      @default("")
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now())

  assignments ShiftAssignment[]

  // --- Phase 5: multi-branch support ---
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([branchId])
}

model ShiftAssignment {
  id        String   @id @default(uuid())
  shiftId   String
  userId    String
  createdAt DateTime @default(now())

  shift      Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  attendance Attendance?

  swapRequestsAsSource StaffRequest[] @relation("SwapSourceAssignment")

  @@unique([shiftId, userId])
  @@index([userId])
}

model Attendance {
  id                String    @id @default(uuid())
  shiftAssignmentId String    @unique
  clockIn           DateTime?
  clockOut          DateTime?
  createdAt         DateTime  @default(now())

  shiftAssignment ShiftAssignment @relation(fields: [shiftAssignmentId], references: [id], onDelete: Cascade)

  // وقتی این حضور در یک اجرای حقوق‌دهی لحاظ شود، برای جلوگیری از پرداخت دوباره ثبت می‌شود.
  payrollPaymentId String?
  payrollPayment   PayrollPayment? @relation(fields: [payrollPaymentId], references: [id])

  @@index([payrollPaymentId])
}

enum StaffRequestType {
  LEAVE
  SHIFT_SWAP
}

enum StaffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model StaffRequest {
  id           String             @id @default(uuid())
  type         StaffRequestType
  userId       String
  status       StaffRequestStatus @default(PENDING)
  reason       String             @default("")
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  // برای درخواست مرخصی (LEAVE)
  startDate DateTime?
  endDate   DateTime?

  // برای درخواست جابجایی شیفت (SHIFT_SWAP): شیفت مبدأ متعلق به userId
  // و همکاری که قرار است آن را عهده‌دار شود.
  sourceAssignmentId String?
  targetUserId       String?

  user             User             @relation("StaffRequestUser", fields: [userId], references: [id])
  reviewedBy       User?            @relation("StaffRequestReviewer", fields: [reviewedById], references: [id])
  sourceAssignment ShiftAssignment? @relation("SwapSourceAssignment", fields: [sourceAssignmentId], references: [id])
  targetUser       User?            @relation("StaffRequestTargetUser", fields: [targetUserId], references: [id])

  @@index([userId])
  @@index([status])
}

model PayrollPayment {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  totalHours  Float
  hourlyRate  Float
  totalAmount Float
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  attendances Attendance[]

  @@index([userId])
}

// =====================================================================
// Phase 5: Multi-Branch Support
// =====================================================================

// شعبه‌ی فیزیکی رستوران. دقیقاً یک شعبه باید isDefault=true داشته باشد —
// همان شعبه‌ای که سفارش‌های آنلاین (که فعلاً انتخاب شعبه ندارند) و شعبه‌ی
// اولیه‌ی سیستم (پیش از وجود این ماژول) به آن نگاشت می‌شوند.
model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  users           User[]
  tables          Table[]
  reservations    Reservation[]
  orders          Order[]
  transactions    Transaction[]
  suppliers       Supplier[]
  purchaseOrders  PurchaseOrder[]
  shifts          Shift[]
  inventoryStocks BranchInventoryStock[]

  // --- Phase 12: waitlist & reservation deposits ---
  waitlistEntries WaitlistEntry[]
}

// =====================================================================
// Phase 6: CRM & Marketing
// =====================================================================

enum CampaignSegmentType {
  ALL // همه‌ی مشتریانی که اجازه‌ی دریافت پیامک بازاریابی داده‌اند
  TIER // یک سطح مشخص از باشگاه وفاداری (segmentParams.tier)
  TAG // مشتریان دارای یک برچسب مشخص (segmentParams.tag)
  INACTIVE // مشتریانی که از N روز پیش بازدید/سفارشی نداشته‌اند (segmentParams.daysSinceLastVisit)
  CUSTOM // فهرست دستی از شناسه‌ی مشتریان (segmentParams.customerIds)
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPT_OUT
}

// یادداشت داخلی پرسنل روی پروفایل یک مشتری (تاریخچه‌ی تعامل/سلیقه/شکایت و...).
model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([customerId])
}

// یک کمپین پیامکی بازاریابی: پیام + بخش هدف (segment)؛ فقط ADMIN می‌سازد و ارسال می‌کند.
model Campaign {
  id             String              @id @default(uuid())
  name           String
  message        String
  segmentType    CampaignSegmentType
  segmentParams  Json?
  status         CampaignStatus      @default(DRAFT)
  recipientCount Int                 @default(0)
  sentCount      Int                 @default(0)
  failedCount    Int                 @default(0)
  createdById    String
  createdAt      DateTime            @default(now())
  sentAt         DateTime?

  createdBy  User                @relation(fields: [createdById], references: [id])
  recipients CampaignRecipient[]
}

// وضعیت ارسال یک کمپین به هر مشتری، برای گزارش‌گیری و جلوگیری از ارسال تکراری.
model CampaignRecipient {
  id         String                  @id @default(uuid())
  campaignId String
  customerId String
  status     CampaignRecipientStatus @default(PENDING)
  sentAt     DateTime?
  error      String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId])
  @@index([customerId])
}

// بازخورد/امتیاز مشتری روی یک سفارش تکمیل‌شده (از طریق پورتال آنلاین مشتری).
model OrderFeedback {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// --- Phase 10: refunds & returns ---
// یک رویداد مرجوعی روی یک سفارش تکمیل‌شده — جزئی (چند ردیف/تعداد مشخص) یا
// کامل (تمام مانده‌ی هر ردیف). هر مرجوعی دقیقاً یک تراکنش EXPENSE در
// حسابداری (دسته‌ی سیستمی «مرجوعی و استرداد») می‌سازد؛ تراکنش درآمد اصلی
// سفارش هرگز حذف یا ویرایش نمی‌شود (طبق قاعده‌ی فاز ۷). موجودی انبار برای
// اقلام مرجوع‌شده همیشه به شعبه‌ی سفارش (یا شعبه‌ی پیش‌فرض برای سفارش
// آنلاینِ بدون‌شعبه) بازگردانده می‌شود — بدون تفکیک کالای سالم/معیوب.
model Refund {
  id             String   @id @default(uuid())
  orderId        String
  reason         String
  isFullRefund   Boolean
  subtotalAmount Float
  taxAmount      Float    @default(0)
  totalAmount    Float
  createdAt      DateTime @default(now())

  order           Order        @relation(fields: [orderId], references: [id])
  items           RefundItem[]
  createdByUserId String
  createdBy       User         @relation("RefundCreatedBy", fields: [createdByUserId], references: [id])

  @@index([orderId])
}

// یک ردیف مرجوعی: چه تعداد از کدام ردیف سفارش (OrderItem) در این رویداد
// مرجوع شده و مبلغ متناظرش (بدون احتساب مالیات/بسته‌بندی — آن‌ها روی خودِ
// Refund سرجمع محاسبه می‌شوند).
model RefundItem {
  id          String @id @default(uuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Float

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([refundId])
  @@index([orderItemId])
}

// =====================================================================
// Phase 11: Audit Log (رویدادهای حساس)
// =====================================================================

// لاگ عملیات و ممیزی — طبق تصمیم صریح کاربر، فقط رویدادهای «حساس» ثبت
// می‌شوند: حذف/ویرایش تراکنش مالی، ثبت مرجوعی، تغییر تنظیمات رستوران/سامانه
// مودیان، ایجاد/حذف کاربر، اجرای حقوق‌دهی، و ورود موفق/ناموفق. سفارش‌های
// عادی POS و عملیات صرفاً خواندنی (لیست‌ها، گزارش‌ها) هرگز اینجا ثبت
// نمی‌شوند — نک. README برای فهرست کامل و دلیل این محدودیت. تغییر نقش
// کاربر (role change) به‌عنوان رویداد جداگانه ثبت نمی‌شود چون چنین
// اکشنی اصلاً در این کدبیس وجود ندارد (نقش فقط هنگام ایجاد کاربر تعیین
// می‌شود).
//
// actorUserId هنگام ورود ناموفق (نام کاربری نامعتبر/رمز اشتباه) یا پس از
// حذف بعدیِ کاربرِ ثبت‌کننده، null می‌شود (onDelete: SetNull — حذف یک
// کاربر هرگز نباید با تاریخچه‌ی لاگ او مسدود شود)؛ actorName همیشه پر
// است (برای ورود ناموفق، همان نام کاربریِ تلاش‌شده — هرگز رمز عبور).
model AuditLog {
  id          String      @id @default(uuid())
  actorUserId String?
  actorName   String
  actorRole   String?
  action      AuditAction
  entityType  String?
  entityId    String?
  metadata    Json?
  success     Boolean     @default(true)
  createdAt   DateTime    @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  USER_CREATED
  USER_DELETED
  TRANSACTION_DELETED
  TRANSACTION_UPDATED
  REFUND_CREATED
  SETTINGS_UPDATED
  PAYROLL_RUN
}

// =====================================================================
// Phase 12: Waitlist & Reservation Deposits
// =====================================================================

// لیست انتظارِ حضوری (walk-in) — مستقل از Reservation، چون رزرو یک زمان
// آینده‌ی مشخص و میزِ از‌پیش‌تخصیص‌یافته دارد، درحالی‌که مشتری در لیست
// انتظار همین حالا حضور دارد و منتظر آزاد شدن میز است، بدون زمان یا میزِ
// از‌پیش‌معلوم. دسترسی، مثل رزرو فعلی، ADMIN + CASHIER است.
model WaitlistEntry {
  id         String         @id @default(uuid())
  guestName  String
  guestPhone String
  partySize  Int
  notes      String         @default("")
  status     WaitlistStatus @default(WAITING)
  createdAt  DateTime       @default(now())
  seatedAt   DateTime?

  // میزی که این مشتری روی آن نشانده شده (فقط بعد از seatFromWaitlist مقداردهی می‌شود).
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])

  // --- Phase 5: multi-branch support ---
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, status])
}

enum WaitlistStatus {
  WAITING
  SEATED
  CANCELLED
}

// =====================================================================
// Phase 13: Precise Recipe/BOM (modifiers, yield %, sub-recipes)
// =====================================================================

// زیرفرمول (Sub-recipe) — یک آماده‌سازیِ میانی و غیرقابل‌فروش (مثلاً یک
// سس یا خمیر پایه) که خودش از مواد اولیه‌ی خام و/یا زیرفرمول‌های دیگر
// ساخته می‌شود و می‌تواند به‌عنوان یک «ماده‌ی اولیه» در فرمول چند آیتم منو
// (یا چند زیرفرمول دیگر) استفاده شود. عمداً یک مدل جدا از MenuItem است،
// نه یک آیتم منوی «غیرقابل‌فروش»، تا هیچ فرضِ موجودِ کد روی MenuItem
// (قیمت‌گذاری، نمایش در منو، سفارش‌پذیری) را به‌هم نریزد.
model SubRecipe {
  id        String   @id @default(uuid())
  name      String   @unique
  // واحدی که خروجیِ این زیرفرمول با آن اندازه‌گیری می‌شود (مثلاً «کیلوگرم»
  // یا «لیتر») — صرفاً برای نمایش در رابط کاربری؛ محاسبات بر پایه‌ی همان
  // quantity/yieldPercent هر ردیف مصرف‌کننده انجام می‌شود.
  unit      String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // ردیف‌های فرمولِ خودِ این زیرفرمول (از چه چیزهایی ساخته می‌شود)
  items SubRecipeItem[]

  // جاهایی که این زیرفرمول به‌عنوان یک «ماده‌ی اولیه» مصرف می‌شود
  usedInMenuItemRecipes RecipeItem[]
  usedInSubRecipes      SubRecipeItem[] @relation("SubRecipeAsIngredient")
}

// دقیقاً مثل RecipeItem: هر ردیف یا به یک ماده‌ی اولیه‌ی خام
// (inventoryItemId) یا به یک زیرفرمولِ دیگر (childSubRecipeId) اشاره
// می‌کند — هرگز هر دو یا هیچ‌کدام (اعمال‌شده در سطح اکشن سرور). جلوگیری
// از حلقه (زیرفرمولی که مستقیم یا غیرمستقیم به خودش برمی‌گردد) هم در سطح
// اکشن سرور، با پیمایشِ کامل درخت پیش از ذخیره، انجام می‌شود.
model SubRecipeItem {
  id               String  @id @default(uuid())
  subRecipeId      String
  inventoryItemId  String?
  childSubRecipeId String?
  quantity         Float
  yieldPercent     Float   @default(100)

  subRecipe      SubRecipe      @relation(fields: [subRecipeId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  childSubRecipe SubRecipe?     @relation("SubRecipeAsIngredient", fields: [childSubRecipeId], references: [id], onDelete: Restrict)

  @@unique([subRecipeId, inventoryItemId])
  @@unique([subRecipeId, childSubRecipeId])
}

// گروهِ مدیفایر/افزودنی (مثلاً «افزودنی‌های پیتزا» یا «سطح تندی») — به یک
// یا چند آیتم منو، از طریق MenuItemModifierGroup، متصل می‌شود تا در چند
// آیتم قابل استفاده‌ی مجدد باشد.
model ModifierGroup {
  id        String   @id @default(uuid())
  name      String
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  createdAt DateTime @default(now())

  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]
}

model MenuItemModifierGroup {
  id              String @id @default(uuid())
  menuItemId      String
  modifierGroupId String

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
}

// یک گزینه‌ی مشخص داخل یک گروهِ مدیفایر (مثلاً «پنیر اضافه» یا «بدون سس»).
// priceDelta به قیمت پایه‌ی آیتم منو اضافه می‌شود (می‌تواند صفر یا منفی
// هم باشد). اثرِ آن روی موجودی از طریق ModifierRecipeItem تعریف می‌شود.
model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceDelta      Float    @default(0)
  createdAt       DateTime @default(now())

  modifierGroup  ModifierGroup        @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  recipeItems    ModifierRecipeItem[]
  orderItemLinks OrderItemModifier[]
}

// اثرِ یک مدیفایر روی مصرف موجودی. quantity می‌تواند مثبت باشد (مدیفایر
// چیزی اضافه می‌کند، مثل «پنیر اضافه») یا منفی (مدیفایر چیزی را از فرمول
// پایه کم می‌کند، مثل «بدون سس»). مجموع نهایی هر ماده‌ی اولیه در هر ردیف
// سفارش، در سطح صفر کلیپ می‌شود — نمی‌توان کمتر از صفر واحد کسر کرد.
model ModifierRecipeItem {
  id              String @id @default(uuid())
  modifierId      String
  inventoryItemId String
  quantity        Float

  modifier      Modifier      @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([modifierId, inventoryItemId])
}

// عکسِ لحظه‌ای مدیفایرهای انتخاب‌شده روی یک ردیفِ سفارشِ واقعی — نام و
// افزایشِ قیمت همان لحظه ذخیره می‌شوند (دقیقاً مثل الگوی priceAtTime)، تا
// اگر مدیفایر بعداً ویرایش/حذف شود، تاریخچه‌ی سفارش‌های قبلی دست‌نخورده
// بماند.
model OrderItemModifier {
  id           String  @id @default(uuid())
  orderItemId  String
  modifierId   String?
  modifierName String
  priceDelta   Float

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)
}

// عکسِ لحظه‌ایِ «هر واحد از این ردیفِ سفارش دقیقاً چقدر از این ماده‌ی
// اولیه مصرف کرد» — بعد از اعمال درصد بازده، بسطِ کاملِ زیرفرمول‌ها و
// مدیفایرهای انتخابی، در همان لحظه‌ی ثبت سفارش محاسبه و ذخیره می‌شود. هم
// کسرِ موجودیِ سفارش و هم برگردانِ موجودیِ مرجوعی (refund.ts) از همین
// عکسِ لحظه‌ای استفاده می‌کنند، نه از فرمولِ زنده‌ی فعلی — تا اگر فرمول یا
// مدیفایر بین ثبت سفارش و مرجوعی تغییر کند، مرجوعی همچنان دقیقاً همان
// مقداری را که واقعاً کسر شده بود برمی‌گرداند.
model OrderItemIngredientUsage {
  id              String @id @default(uuid())
  orderItemId     String
  inventoryItemId String
  // مقدار مصرفِ این ماده‌ی اولیه به‌ازای «یک واحد» از این ردیفِ سفارش —
  // کسرِ واقعی از موجودی برابر است با quantityPerUnit × OrderItem.quantity.
  quantityPerUnit Float

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, inventoryItemId])
}

// =====================================================================
// فاز ۱۴: کارت هدیه و کد تخفیف (Gift Cards & Discount Coupons)
// =====================================================================
// هر دو زیرامکان با هم و فقط برای ADMIN مدیریت می‌شوند (مطابق تصمیمِ
// محدوده‌ی تأییدشده، هم‌سو با مدل دسترسیِ فرمول/BOM در فازِ ۱۳).
//
// تصمیم‌های محدوده‌ی مشخص (اعلام‌شده به کاربر در گزارش پایانی این فاز):
// - صدورِ کارتِ هدیه هیچ تراکنشِ حسابداری‌ای ثبت نمی‌کند (فرض بر این است
//   که یا هدیه/جبرانی است یا وجهش جای دیگری حساب شده)؛ فقط استفاده از آن
//   در سفارش، مبلغِ نهاییِ سفارش (و به‌تبع، تراکنشِ درآمدِ همان سفارش) را
//   کم می‌کند — دقیقاً مثل کد تخفیف که خودش هم تراکنشی نمی‌سازد.
// - مالیات روی «مبلغِ ناخالصِ اقلام» (subtotal) قبل از اعمالِ کدِ تخفیف
//   محاسبه می‌شود — هم‌سو با رفتارِ از پیش موجودِ فازِ ۲ که مالیات را قبل
//   از تخفیفِ امتیازِ وفاداری محاسبه می‌کند؛ یک مبنای مالیاتیِ واحد برای
//   کل سیستم، نه قاعده‌ی جداگانه برای هر نوع تخفیف.
// - کارتِ هدیه به‌عنوانِ آخرین لایه، بعد از کدِ تخفیف و (در سفارش آنلاین)
//   بعد از تخفیفِ امتیازِ وفاداری اعمال می‌شود — مثلِ یک روشِ پرداختِ
//   جزئی، نه یک تخفیفِ قیمتی.
// - مرجوعی (refund.ts) کاملاً دست‌نخورده می‌ماند: مبلغِ مرجوعی همچنان فقط
//   از رویِ قیمتِ ردیف‌های سفارش/مالیات محاسبه می‌شود، بدونِ درنظرگرفتنِ
//   این‌که سفارش با کدِ تخفیف/کارتِ هدیه پرداخت شده بود یا نه؛ استفاده از
//   کارتِ هدیه/کدِ تخفیف در یک سفارش به‌طورِ خودکار در مرجوعیِ آن سفارش
//   برگردانده نمی‌شود (نه افزایشِ مجددِ موجودیِ کارت، نه کاهشِ شمارشِ
//   استفاده‌ی کد) — خارج از محدوده‌ی این فاز؛ جبرانِ مشتری پس از مرجوعی
//   (در صورتِ نیاز) با صدورِ دستیِ یک کارتِ هدیه‌ی جدید توسط ADMIN انجام
//   می‌شود.

enum GiftCardTransactionType {
  ISSUE
  REDEEM
}

model GiftCard {
  id              String    @id @default(uuid())
  code            String    @unique
  initialBalance  Float
  currentBalance  Float
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  note            String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  issuedToCustomerId String?
  issuedToCustomer   Customer? @relation(fields: [issuedToCustomerId], references: [id])

  transactions GiftCardTransaction[]
  orders       Order[]
}

// دفترچه‌ی تراکنش‌های هر کارتِ هدیه (صدور، استفاده) — برای شفافیت و
// قابلیتِ ردیابیِ کاملِ تغییراتِ موجودیِ کارت.
model GiftCardTransaction {
  id           String                  @id @default(uuid())
  giftCardId   String
  giftCard     GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?                  @relation(fields: [orderId], references: [id])
  type         GiftCardTransactionType
  amount       Float
  balanceAfter Float
  createdAt    DateTime                @default(now())
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id              String             @id @default(uuid())
  code            String             @unique
  discountType    CouponDiscountType
  value           Float
  minOrderAmount  Float              @default(0)
  // null = بدونِ سقفِ تعدادِ استفاده در کلِ سیستم.
  maxUses         Int?
  usesCount       Int                @default(0)
  expiresAt       DateTime?
  isActive        Boolean            @default(true)
  createdByUserId String?
  createdAt       DateTime           @default(now())

  orders Order[]
}

// =====================================================================
// فاز ۱۵: کمبو و قیمت‌گذاری زمان‌بندی‌شده (Combo Meals & Happy Hour)
// =====================================================================
// هر دو زیرامکان با هم و فقط برای ADMIN مدیریت می‌شوند (تصمیمِ محدوده‌ی
// تأییدشده، هم‌سو با مدلِ دسترسیِ فازهای ۱۳/۱۴).
//
// تصمیم‌های محدوده‌ی مشخص (اعلام‌شده در گزارشِ پایانیِ این فاز):
// - هر Combo داخلاً با یک «آیتمِ منویِ سایه» (MenuItem.isCombo=true)
//   نمایندگی می‌شود که نام/قیمت/دسته‌بندی/ایستگاهِ آشپزخانه/در‌دسترس‌بودنش
//   از خودِ Combo همگام می‌شود. این یعنی سبدِ خرید، صندوق، منویِ آنلاین،
//   تابلویِ آشپزخانه، رسید، مرجوعی و آنالیزِ فروش همگی بدونِ هیچ تغییرِ
//   کدی یک Combo را دقیقاً مثلِ یک آیتمِ منویِ معمولی می‌بینند — تنها
//   محلِ ویژه‌ای که Combo را می‌شناسد، بسطِ فرمولِ مصرفِ موادِ اولیه است
//   (نک. recipeExpansion.ts) که مصرفِ آن را از رویِ اجزای Combo (نه یک
//   RecipeItem مستقیم) محاسبه می‌کند.
// - یک Combo نمی‌تواند شاملِ Combo دیگری باشد (اعمال‌شده در سطحِ اکشنِ
//   سرور) — صرفاً برای جلوگیری از پیچیدگی/حلقه‌ی غیرضروری.
// - Combo از مدیفایر/افزودنی پشتیبانی نمی‌کند در این فاز — آیتمِ سایه‌ی
//   آن هرگز به یک ModifierGroup متصل نمی‌شود.
// - تخفیفِ Happy Hour فقط رویِ آیتم‌های منویِ معمولی اعمال می‌شود، نه رویِ
//   Comboها — یک Combo از پیش قیمتِ بسته‌ی خودش را دارد.
// - اگر چند قانونِ Happy Hourِ فعال هم‌زمان روی یک آیتم منطبق باشند،
//   قانونی که بیش‌ترین تخفیف را می‌دهد اعمال می‌شود (همیشه به نفعِ
//   مشتری) — رابطِ کاربریِ مدیریت، هم‌پوشانیِ بازه‌ی زمانی/روزها را در
//   لحظه‌ی ذخیره بررسی/مسدود نمی‌کند (این بررسی خارج از محدوده‌ی این
//   فاز است).
// - محاسبه‌ی «زمانِ فعلی» بر مبنای زمانِ سرور است، دقیقاً مثلِ سایرِ
//   بخش‌های این کدبیس (مثلاً createdAt رزروها/لاگ ممیزی) — نه یک منطقه‌ی
//   زمانیِ صریحاً تنظیم‌شده برای رستوران.
// - برگردانِ اجزای هر Combo هنگامِ سفارش (OrderItemComboComponent) فقط
//   برای شفافیت/گزارشِ آینده ذخیره می‌شود؛ رسید و تابلوی آشپزخانه در این
//   فاز هنوز آن را نمایش نمی‌دهند (دقیقاً مثلِ هر آیتمِ منویِ دیگر، فقط
//   نامِ خودِ Combo چاپ/نمایش داده می‌شود).

model Combo {
  id              String   @id @default(uuid())
  name            String
  price           Float
  isActive        Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())

  // آیتمِ منویِ سایه‌ای که این Combo را در سراسرِ سیستم نمایندگی می‌کند
  // (نک. توضیحِ بالا).
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  items ComboItem[]
}

// یکی از اجزای یک Combo — کدام آیتمِ منو، به چه تعداد.
model ComboItem {
  id         String @id @default(uuid())
  comboId    String
  menuItemId String
  quantity   Int    @default(1)

  combo    Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([comboId, menuItemId])
}

// عکسِ لحظه‌ایِ اجزای یک Combo روی یک ردیفِ سفارشِ واقعی، در لحظه‌ی ثبتِ
// سفارش (دقیقاً همان الگویِ OrderItemModifier) — تا اگر ترکیبِ Combo
// بعداً تغییر کند، تاریخچه‌ی سفارش‌های قبلی دست‌نخورده بماند.
model OrderItemComboComponent {
  id            String @id @default(uuid())
  orderItemId   String
  menuItemId    String?
  menuItemTitle String
  quantity      Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItem  MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
}

enum HappyHourDiscountType {
  PERCENT
  FIXED
}

// یک قانونِ تخفیفِ زمان‌بندی‌شده (Happy Hour): درصد یا مبلغِ ثابت، روی
// یک یا چند آیتمِ منویِ معمولی، در بازه‌ی زمانیِ startMinute..endMinute
// (دقیقه از نیمه‌شب — مثلاً ۱۰۲۰ یعنی ۱۷:۰۰) از روزهایِ هفته‌ی مشخص‌شده
// در daysOfWeek (۰=یکشنبه هماهنگ با Date.getDay() جاوااسکریپت، یعنی
// ۰=Sunday..6=Saturday — نه تقویمِ هفته‌ی ایرانی). بازه‌ای که endMinute
// از startMinute کوچک‌تر باشد، به‌عنوانِ بازه‌ای که از نیمه‌شب عبور
// می‌کند تفسیر می‌شود (مثلاً ۲۳:۰۰ تا ۰۱:۰۰).
model HappyHourRule {
  id              String                @id @default(uuid())
  name            String
  discountType    HappyHourDiscountType
  value           Float
  daysOfWeek      Int[]
  startMinute     Int
  endMinute       Int
  isActive        Boolean               @default(true)
  createdByUserId String?
  createdAt       DateTime              @default(now())

  items      HappyHourRuleItem[]
  orderItems OrderItem[]
}

// اتصالِ یک قانونِ Happy Hour به یک آیتمِ منویِ مشخص.
model HappyHourRuleItem {
  id         String @id @default(uuid())
  ruleId     String
  menuItemId String

  rule     HappyHourRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([ruleId, menuItemId])
}
