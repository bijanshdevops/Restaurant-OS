generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  roles     Role[]   @default([CASHIER])
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  CASHIER
  CHEF
  ACCOUNTANT
  INVENTORY_MANAGER
}

model MenuItem {
  id          String      @id @default(cuid())
  title       String
  category    String
  subCategory String?
  price       Float
  imageUrl    String?
  isAvailable Boolean     @default(true)
  ingredients String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Float
  customerId  String?
  tableId     String?
  createdAt   DateTime    @default(now())
  items       OrderItem[]
  customer    Customer?   @relation(fields: [customerId], references: [id])
  table       Table?      @relation(fields: [tableId], references: [id])
  taxInvoice  TaxInvoice?
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  menuItemId  String
  quantity    Int
  priceAtTime Float
  
  order       Order    @relation(fields: [orderId], references: [id])
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
}

model InventoryItem {
  id            String   @id @default(uuid())
  name          String
  category      String
  unit          String
  currentStock  Float    @default(0)
  minStockLevel Float    @default(0)
  costPerUnit   Float    @default(0)
  lastRestocked DateTime @default(now())
  recipeItems   RecipeItem[]
}

model RecipeItem {
  id              String        @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantity        Float

  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
}

model Customer {
  id           String        @id @default(uuid())
  fullName     String
  phone        String        @unique
  totalOrders  Int           @default(0)
  totalSpent   Float         @default(0)
  loyaltyTier  LoyaltyTier   @default(NORMAL)
  lastVisit    DateTime      @default(now()) @updatedAt
  orders       Order[]
  reservations Reservation[]
}

model RestaurantSettings {
  id             String   @id @default("default")
  taxPercentage  Float    @default(10)
  packagingCost  Float    @default(5000)
  restaurantName String   @default("رستوران نمونه سیستم‌عامل")
  contactNumber  String   @default("")
  footerMessage  String   @default("")

  // سامانه مودیان (از طریق معتمد مالیاتی / TSP)
  modianEnabled    Boolean @default(false)
  economicCode     String  @default("")
  nationalId       String  @default("")
  tspProviderName  String  @default("")
  tspApiBaseUrl    String  @default("")
  tspApiKey        String  @default("")

  updatedAt      DateTime @updatedAt
}

model Table {
  id           String        @id @default(uuid())
  number       Int           @unique
  capacity     Int           @default(4)
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  orders       Order[]
  reservations Reservation[]
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

model Reservation {
  id              String            @id @default(uuid())
  tableId         String
  customerId      String?
  guestName       String
  guestPhone      String
  partySize       Int
  reservationTime DateTime
  status          ReservationStatus @default(PENDING)
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  table    Table     @relation(fields: [tableId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TaxInvoice {
  id              String           @id @default(uuid())
  orderId         String           @unique
  status          TaxInvoiceStatus @default(PENDING)
  payload         Json
  uid             String?
  referenceNumber String?
  taxUid          String?
  errorMessage    String?
  sentAt          DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

enum TaxInvoiceStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

enum LoyaltyTier {
  NORMAL
  BRONZE
  SILVER
  GOLD
  VIP
}

model Transaction {
  id          String          @id @default(uuid())
  type        TransactionType
  description String
  amount      Float
  createdAt   DateTime        @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Printer {
  id             String      @id @default(uuid())
  name           String
  type           PrinterType
  connectionType PrinterConnectionType @default(NETWORK)
  
  ipAddress      String?
  port           Int?        @default(9100)
  
  path           String?

  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
}

enum PrinterType {
  CASHIER
  KITCHEN
}

enum PrinterConnectionType {
  NETWORK
  USB
  BLUETOOTH
}
